APP_NAME="WorkWize MDM Sync"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=workwize_mdm
DB_USERNAME=workwize
DB_PASSWORD=workwize_secret

CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Jamf provider: "mock" reads the bundled JSON fixture (used for this
# assignment). Switching to another mode is where a real HTTP client
# implementation would be wired in later.
JAMF_MODE=mock
JAMF_MOCK_PATH=/var/www/html/mock/jamf/api-mock-response.json

# Comma separated list of origins allowed to call the API (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173
